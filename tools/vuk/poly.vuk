// p(x) = c[0] + c[1] x + ... + c[D] x^D for every lane of x, in place,
// by Horner's method.

const D = 16;

kernel poly(n: i16, c: f32[D + 1], x: f32x4[]) {
    for i in 0..n {
        var v = x[i];
        var y = c[D] * v + c[D - 1];
        for k in 2..D + 1 {
            y = y * v + c[D - k];
        }
        x[i] = y;
    }
}
