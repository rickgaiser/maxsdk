// procgen trees (PLAN_PROCGEN): one textured sprite per tree, standing on its
// point, sized by the distance. Two GS vertices per input point (SPRITE).
// A sprite that reaches outside the guard band or a tree near the eye is not
// drawn (ADC on its second vertex).
shader tree {
    uniform mvp: f32x4[4];
    uniform fogc: f32x4;
    uniform bb: f32x4;      // x: half width * fx, y: height * fy (pixels at w = 1)
    uniform uvc: f32x4;     // texture corners u0, v0, u1, v1 (texels)
    uniform clip: f32x4;    // x: the centre of the screen, y: guard band, z: the nearest w
    in pos: v3_32;
    var p = mvp[0] * pos.x + mvp[1] * pos.y + mvp[2] * pos.z + mvp[3];
    var q = rcp(p.w);
    var c = p * q;
    var fog = clamp(p.w * fogc.x + fogc.y, 0, 255);
    var hw = q * bb.x;
    var h = q * bb.y;
    var ex = max(max(abs(c.x - clip.x) + hw, abs(c.y - clip.x) + h) - clip.y, clip.z - p.w);
    var adc = clamp(ex * 1000000000, 0, 2048);
    out uv = ftoi4(vec(uvc.x, uvc.y, 0, 0));
    out xyzf2 = ftoi4(vec(c.x - hw, c.y - h, c.z, fog));
    out uv = ftoi4(vec(uvc.z, uvc.w, 0, 0));
    out xyzf2 = ftoi4(vec(c.x + hw, c.y, c.z, fog + adc));
}
