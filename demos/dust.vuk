// procgen dust (PLAN_PROCGEN P4): motes that drift in a wind field, on VU0,
// every frame. x[i]: the position in box units (xyz, wrapped to 0..1; the box
// is laid around the eye when drawn, demos/dustdraw.vuk), w: the mote's own
// phase. The wind is a swirl that changes with the place and the time, so
// the motes follow their own paths: a state that VU0 carries from frame to
// frame, not a function of the time alone.
// c: dt * speed (box units), the time, the swirl, the sink * dt.
unit vu0;

kernel dust(n: i16, c: f32[4], x: f32x4[]) {
    for i in 0..n {
        var p = x[i];
        // the three waves of the wind in one sin, a field each
        var s = sin(vec(p.z * 9.0 + c[1] * 0.9 + p.w, p.x * 7.0 - c[1] * 0.6 + p.w * 1.3,
                        (p.x + p.z) * 5.0 + c[1] * 1.1, 0));
        var d = vec(s.x * c[2] + 0.4, s.z * 0.3, s.y * c[2] + 0.2, 0) * c[0] - vec(0, c[3], 0, 0);
        // not wrapped here: dustdraw.vuk wraps into the box; the drift stays
        // far below the precision limit for hours
        x[i] = with_w(p + d, p.w);
    }
}
