// Terrain heights (PLAN_PROCGEN P3): fractal value noise, OCT octaves, on
// VU0. x[i] = (x, z, 0, _) in lattice units in; the height, about -1..1, is
// x[i].z out (x and y are the coordinates of a next octave).
//
// The lattice hash is Dave Hoskins' hash12 ("hash without sine"), on the four
// corners of a cell at once, one per field: no tables, only FMAC
// instructions. Between the corners: smoothstep.
//
// The octaves (oct of them, 6 is good) are the outer loop and the points the
// inner one: each octave is a loop over independent points, which the
// compiler pipelines, with the sum and the coordinates kept in x[i] between
// octaves.
unit vu0;

kernel fbm(n: i16, oct: i16, x: f32x4[]) {
    var amp = 0.5;
    for o in 0..oct {
        for i in 0..n {
            var v = x[i];
            var px = v.x;
            var py = v.y;
            var ix = floor(px);
            var iy = floor(py);
            var fx = px - ix;
            var fy = py - iy;
            var cx = ix + vec(0, 1, 0, 1);
            var cy = iy + vec(0, 0, 1, 1);
            var a = cx * 0.1031;
            a = a - floor(a);
            var b = cy * 0.1031;
            b = b - floor(b);
            // p3 = (a, b, a); p3 += dot(p3, p3.yzx + 33.33)
            var d = a * (b + 33.33) + b * (a + 33.33) + a * (a + 33.33);
            var h = (a + d + b + d) * (a + d);
            h = h - floor(h);
            var sx = fx * fx * (3 - 2 * fx);
            var sy = fy * fy * (3 - 2 * fy);
            var h0 = lerp(h.x, h.y, sx);
            var h1 = lerp(h.z, h.w, sx);
            var sum = v.z + (lerp(h0, h1, sy) * 2 - 1) * amp;
            // the next octave: twice the frequency, rotated by about 37
            // degrees so that the lattices do not line up
            var nx = (px * 0.8 - py * 0.6) * 2 + 17.1;
            var ny = (px * 0.6 + py * 0.8) * 2 + 3.7;
            x[i] = vec(nx, ny, sum, sum);
        }
        amp = amp * 0.5;
    }
}
