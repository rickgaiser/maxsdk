// procgen water (PLAN_PROCGEN): a flat grid moved by two travelling sine
// waves on VU1; the colour follows the waves, alpha blended, fogged. The
// input is the grid point in chunk coordinates (y = the water level).
// Clipping as in lvl3: a triangle with a vertex outside the guard band or
// near the eye is not drawn (ADC on its last vertex).
shader water {
    uniform mvp: f32x4[4];
    uniform fogc: f32x4;
    uniform wave: f32x4;    // x: phase (time), y: amplitude, z, w: chunk origin x, z
    uniform wcol: f32x4;    // base colour 0..255, alpha in w
    uniform clip: f32x4;    // x: the centre of the screen, y: guard band, z: the nearest w
    in pos: v3_32;
    state exs = 0;          // x: the excess of the vertex before, y: of the one before that
    var wx = pos.x + wave.z;
    var wz = pos.z + wave.w;
    var s1 = sin(wx * 0.11 + wz * 0.07 + wave.x);
    var s2 = sin(wz * 0.13 - wx * 0.05 + wave.x * 1.3);
    var y = (s1 + s2 * 0.6) * wave.y;
    var p = mvp[0] * pos.x + mvp[1] * (pos.y + y) + mvp[2] * pos.z + mvp[3];
    var fog = clamp(p.w * fogc.x + fogc.y, 0, 255);
    var c = wcol + (s1 + s2) * 14;
    var o = abs(p - p.w * clip.x) - p.w * clip.y;
    var ex = max(max(o.x, o.y), clip.z - p.w);
    var adc = clamp(max(ex, max(exs.x, exs.y)) * 1000000000, 0, 2048);
    exs = with_y(ex, exs.x);
    out rgbaq = ftoi0(with_w(c, wcol.w));
    out xyzf2 = ftoi4(with_w(p / p.w, fog + adc));
}
