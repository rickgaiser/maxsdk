// Quality level 1 (PLAN_PROCGEN): Gouraud with one directional light. The
// normal is V4-8 (signed, length 127), the base colour V4-8 (0..255).
shader lvl1 {
    uniform mvp: f32x4[4];
    uniform light: f32x4;  // towards the light in object space, divided by 127; w 0
    uniform lcol: f32x4;   // light colour (1 = the base colour); w 0
    uniform amb: f32x4;    // ambient; w 1 keeps the alpha
    in pos: v3_32;
    in nrm: v4_8;
    in col: v4_8u;
    var p = mvp[0] * pos.x + mvp[1] * pos.y + mvp[2] * pos.z + mvp[3];
    var d = max(dot3(itof0(nrm), light), 0);
    out rgbaq = ftoi0(min(itof0(col) * (amb + lcol * d), 255)); // 255: RGBAQ keeps 8 bits
    out xyz2 = ftoi4(p / p.w);
}
