; In-place kernel: header quadword 0 holds the item count (x), items from
; quadword 1 are doubled. Used on VU0 and VU1.
	.section .vutext, "ax", @progbits
	nop		ilw.x vi1, 0(vi0)
	nop		iaddiu vi2, vi0, 1
loop:
	nop		lq.xyzw vf1, 0(vi2)
	add.xyzw vf1, vf1, vf1	nop
	nop		isubiu vi1, vi1, 1
	nop		sq.xyzw vf1, 0(vi2)
	nop		iaddiu vi2, vi2, 1
	nop		ibne vi1, vi0, loop
	nop		nop
	nop[e]		nop
	nop		nop
