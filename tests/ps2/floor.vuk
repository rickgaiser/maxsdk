// tests/ps2/floor.c: vuk's floor on VU0: of a vector (x, -x, y, -y), and of
// the scalar z as fbm.vuk takes it (floor(v.z) in field w of the result).
unit vu0;

kernel fl(n: i16, x: f32x4[]) {
    for i in 0..n {
        var v = x[i];
        var f = floor(vec(v.x, -v.x, v.y, -v.y));
        var s = floor(v.z);
        x[i] = with_w(f, s);
    }
}
